# FAROL_DOMAIN=":80" serve só HTTP (antes do DNS). Com um domínio (ex.: farol.community) o Caddy emite TLS sozinho.
{$FAROL_DOMAIN} {
	encode zstd gzip

	@static path /_next/static/* /logo.svg /mark.svg /favicon.svg /og.svg
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	reverse_proxy farol-web:3000 {
		health_uri /api/health
		health_interval 30s
	}
}
