# Copie para .env na VM. Nunca versione o .env.

# RPC Solana. Com a chave Helius, as leituras saem do plano Developer (US$ 49/mês).
# Sem chave, usa o RPC público (limites baixos; só para testar).
HELIUS_API_KEY=
# Alternativa: outro RPC HTTP.
SOLANA_RPC_URL=

# Porta publicada na VM (o proxy do host aponta para ela).
FAROL_PORT=3030

# Só com o Caddy opcional (--profile proxy). Deixe ":80" até o DNS apontar para a VM.
FAROL_DOMAIN=:80

# URL pública (para metadados e compartilhamento). Ex.: https://farol.community
FAROL_PUBLIC_URL=http://localhost

# Rótulo da região mostrado na aba APIs.
FAROL_REGION=vm

# ---------------------------------------------------------------------------
# Iniciar projeto (pipeline automático)
# ---------------------------------------------------------------------------

# Acesso ao painel: e-mail + senha. O login fica ativo quando há FAROL_SECRET (assina o cookie de sessão).
# Primeiro administrador: defina os dois abaixo, reinicie, entre em /entrar e REMOVA a senha do .env.
# A senha é guardada só como hash scrypt em data/users.json. Novos usuários: aba Visão geral.
FAROL_ADMIN_EMAIL=
FAROL_ADMIN_PASSWORD=
FAROL_ADMIN_NAME=

# Token para scripts/automação (header x-farol-token), com papel de administrador. Opcional.
# Gere com: openssl rand -hex 24
FAROL_ADMIN_TOKEN=

# Segredo que cifra as carteiras criadas pelo sistema (AES-256-GCM). Mínimo 16 caracteres.
# Gere com: openssl rand -base64 32   Perder este valor = perder as carteiras.
FAROL_SECRET=

# Domínio-base: cada projeto nasce em https://<slug>.<base>. Exige DNS wildcard (*.base → IP da VM)
# e certificado wildcard no proxy do host. Sem isso, o site fica só em /p/<slug>.
FAROL_BASE_DOMAIN=
# IP público da VM, usado nos registros A dos domínios próprios registrados.
FAROL_PUBLIC_IP=

# Carteira principal da operação (Phantom/Ledger): SÓ O ENDEREÇO PÚBLICO. Nunca coloque chave privada aqui.
# Aparece no Financeiro com saldo e é a origem dos SOL que abastecem a carteira de operação de cada projeto.
FAROL_OWNER_WALLET=

# Lançamento on-chain. Enquanto for 0, o passo "lançamento" para em espera e nada gasta SOL.
FAROL_LAUNCH_ENABLED=0

# Monitor contínuo (snapshots, taxas, alertas). 0 desliga. Intervalo em ms (padrão 60000).
FAROL_MONITOR=1
FAROL_MONITOR_INTERVAL_MS=60000

# Registro de domínio próprio (.xyz ≈ US$ 2 no 1º ano) via Porkbun. Opcional.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Teto por registro, em US$. Acima disso o passo é pulado.
PORKBUN_MAX_USD=3

# Publicar o anúncio na conta oficial do X (OAuth 1.0a da conta do projeto/operação). Opcional.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
